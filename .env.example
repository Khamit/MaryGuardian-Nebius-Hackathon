# =============================================================================
#  MaryGuardian — конфигурация. Скопируйте в .env (он в .gitignore) и заполните.
#  Реальные переменные окружения сильнее значений из .env.
# =============================================================================

# ---- NVIDIA Nemotron на Nebius Token Factory ---------------------------------
# Ключ: https://tokenfactory.nebius.com → API keys. Никогда не коммитьте его.
NEBIUS_API_KEY=Put_THERE_YOUR_REAL_API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# standard: карты, IBAN, SSN/ИНН/БИН, e-mail, телефоны, длинные числа, API-ключи и токены.
# strict:   + названия компаний, номера документов и счетов, ФИО и адреса по метке (From:, Employee:, Address:…), BIC.
PII_MASK_LEVEL=strict

# Три уровня моделей. ID можно проверить командой:  scripts/check_models.sh
NEMOTRON_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B     # массовая классификация
NEMOTRON_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b         # извлечение полей, черновики писем
NEMOTRON_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b         # вопросы по библиотеке

# auto = облако, если задан ключ, иначе локальная модель | remote | local | off (только правила)
LLM_BACKEND=auto

# Reasoning-модели тратят часть токенов на «размышления»: этот запас добавляется к бюджету ответа.
LLM_REASONING_HEADROOM=1536
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=4                    # параллельных вызовов при классификации
LLM_CONTEXT_TOKENS=32000
# Если провайдер требует параметры шаблона (например, отключить thinking у Nano) — JSON подмешается в тело запроса:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ---- Приватность ---------------------------------------------------------------
# Сколько символов документа вообще может уйти в облако (после маскирования).
PII_SNIPPET_CHARS=1200
# Имена и адреса регулярками не поймать — перечислите их здесь (разделитель «;», необязательный префикс ТИП:).
# Их можно задать и в интерфейсе: Settings → «Always hide these».
# PII_PROTECTED_TERMS=PERSON:Jane Roe;ADDRESS:12 Main Street
# Предохранитель кредитов: больше запросов в час шлюз просто не пропустит.
LLM_MAX_REQUESTS_PER_HOUR=2000
LLM_MAX_PROMPT_CHARS=60000

# ---- Сервер -----------------------------------------------------------------------
MG_WORKSPACE=mg_workspace
MG_PORT=8080
# Для публичного демо за прокси: допустимые значения заголовка Host через запятую.
# MG_ALLOWED_HOSTS=demo.example.com
# Демо-режим: только синтетические данные, настройки только для чтения, загрузка моделей отключена.
MG_DEMO_MODE=0
MG_WATCH_INTERVAL_SEC=10             # 0 = только ручной Scan

# ---- Необязательно: локальные модели (офлайн-режим) --------------------------------
# Нужна сборка с -DMG_LOCAL_LLM=ON. Файлы скачиваются кнопкой в Settings
# ТОЛЬКО с https://huggingface.co/ — вставьте прямые ссылки на файлы (…/resolve/main/<имя>.gguf).
LOCAL_MODEL_URL=https://huggingface.co/bartowski/Qwen_Qwen3.5-2B-GGUF/resolve/main/Qwen_Qwen3.5-2B-Q4_K_M.gguf
# LOCAL_MODEL_SHA256=
OCR_MODEL_URL=https://huggingface.co/Abiray/OvisOCR2-GGUF/resolve/main/OvisOCR2-Q6_K.gguf
OCR_MMPROJ_URL=https://huggingface.co/Abiray/OvisOCR2-GGUF/resolve/main/mmproj-F16.gguf
# LOCAL_MODEL_PATH=
# OCR_MODEL_PATH=
# OCR_MMPROJ_PATH=
